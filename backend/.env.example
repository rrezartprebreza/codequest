# AI provider (local default: Ollama)
AI_BASE_URL=http://localhost:11434
AI_API_KEY=ollama
AI_MODEL=llama3.2:3b

# Optional Groq production override
# AI_BASE_URL=https://api.groq.com/openai
# AI_API_KEY=your_groq_api_key_here
# AI_MODEL=llama-3.3-70b-versatile

# Database (defaults work with docker-compose)
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/codequest
DATABASE_USERNAME=codequest
DATABASE_PASSWORD=codequest

# Redis (defaults work with docker-compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Schema strategy (local default)
FLYWAY_ENABLED=false

# Frontend URL for CORS
CORS_ORIGINS=http://localhost:5173
